{
  "name": "rest",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "mocha --recursive rest/test/**/*.test.js",
    "test-external": "mocha 'rest/test/**/*.test.js' --timeout 10000",
    "start": "node server.js",
    "k6:run": "k6 run test/k6/checkout.test.js --out json=tmp/k6-results.json --summary-export=tmp/k6-summary.json --env BASE_URL=http://localhost:3000",
    "k6:report": "node tools/k6-report.js tmp/k6-summary.json reports/k6-report.html",
    "k6:generate-emails": "node tools/generate-emails.js 100 tmp/emails.json",
    "k6:full": "npm run k6:run && npm run k6:report"
  },
  "keywords": [],
